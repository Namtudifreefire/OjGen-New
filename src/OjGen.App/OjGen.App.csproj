<Project Sdk="Microsoft.NET.Sdk">

  <!-- Giao diện WPF của OjGen (phong cách TQLTK). Chỉ chạy trên Windows, cần .NET 10 SDK để build. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <AssemblyName>OjGen</AssemblyName>
    <RootNamespace>OjGen.Gui</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OjGen.Core\OjGen.Core.csproj" />
  </ItemGroup>

</Project>
