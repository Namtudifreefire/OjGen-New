<Window x:Class="OjGen.Gui.ProblemSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thiết lập bài toán" Width="760" Height="680" MinWidth="650" MinHeight="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Style="{StaticResource SlideInWindow}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="lblStep" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="lblStepHint" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16">
            <Grid>
                <StackPanel x:Name="pageBasics">
                    <TextBlock Text="Tên bài hiển thị" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="txtName" />
                    <TextBlock Text="Mã bài / tên thư mục" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="txtCode" ToolTip="Chỉ dùng chữ, số, dấu gạch ngang hoặc gạch dưới." />
                    <TextBlock Text="Khuôn input" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="cmbProblem" DisplayMemberPath="Title" SelectionChanged="CmbProblem_SelectionChanged" />
                    <TextBlock Text="OjGen dùng khuôn này để sinh và kiểm tra input. Có thể chỉnh tham số ở bước tiếp theo." Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
                <ScrollViewer x:Name="pageConfig" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="paramHost" Margin="0,0,8,0" />
                </ScrollViewer>
                <StackPanel x:Name="pageReview" Visibility="Collapsed">
                    <TextBlock Text="Định dạng input của khuôn" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="txtFormat" Style="{StaticResource MonoTextBox}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="210" />
                    <TextBlock Text="Lời giải chuẩn (tùy chọn)" Style="{StaticResource FieldLabel}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Chọn…" Click="BtnBrowseSolution_Click" Style="{StaticResource OutlineButton}" />
                        <TextBox x:Name="txtSolution" AllowDrop="True" Drop="TxtSolution_Drop" />
                    </DockPanel>
                    <TextBlock Text="Hồ sơ lưu khuôn, ràng buộc và lời giải để dùng lại lần sau." Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Mở hồ sơ…" Padding="14,7" Click="BtnLoadProfile_Click" Style="{StaticResource OutlineButton}" />
                <Button Content="Lưu hồ sơ…" Padding="14,7" Margin="6,0,0,0" Click="BtnSaveProfile_Click" Style="{StaticResource OutlineButton}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnBack" Content="← Quay lại" Padding="16,7" Click="BtnBack_Click" Style="{StaticResource OutlineButton}" />
                <Button x:Name="btnNext" Content="Tiếp theo →" Padding="16,7" Margin="6,0,0,0" Click="BtnNext_Click" />
                <Button x:Name="btnFinish" Content="Dùng thiết lập này" Padding="16,7" Margin="6,0,0,0" Click="BtnFinish_Click" Visibility="Collapsed" />
                <Button Content="Hủy" Padding="16,7" Margin="6,0,0,0" Click="BtnCancel_Click" IsCancel="True" Style="{StaticResource OutlineButton}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
