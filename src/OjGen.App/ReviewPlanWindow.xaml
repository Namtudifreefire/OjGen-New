<Window x:Class="OjGen.Gui.ReviewPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rà soát trước khi tạo test" Width="850" Height="720" MinWidth="720" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Style="{StaticResource SlideInWindow}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Rà soát kế hoạch tạo test" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="lblSummary" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
            <TextBlock x:Name="lblValidation" TextWrapping="Wrap" FontWeight="SemiBold" />
        </Border>
        <TextBox Grid.Row="2" x:Name="txtSamples" Style="{StaticResource MonoTextBox}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" />
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="Toàn bộ input sẽ tiếp tục được kiểm tra khi sinh; lời giải chuẩn sẽ chạy trên từng test trước khi đóng gói." Style="{StaticResource HintText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Content="Quay lại chỉnh sửa" Padding="16,7" Click="BtnCancel_Click" IsCancel="True" Style="{StaticResource OutlineButton}" />
                <Button x:Name="btnCreate" Content="Tạo bộ test" Padding="20,7" Margin="6,0,0,0" Click="BtnCreate_Click" IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
