<Window x:Class="OjGen.Gui.StatementEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Soạn đề bài" Width="1260" Height="850" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Style="{StaticResource SlideInWindow}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="130" /><ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Tên bài" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="txtName" TextChanged="Document_TextChanged" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="Mã bài" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="txtCode" TextChanged="Document_TextChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                <TextBlock Text="Thời gian (ms)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="txtTime" Text="2000" TextChanged="Document_TextChanged" />
            </StackPanel>
            <StackPanel Grid.Column="3">
                <TextBlock Text="Bộ nhớ (MB)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="txtMemory" Text="256" TextChanged="Document_TextChanged" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.12*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="0.88*" />
            </Grid.ColumnDefinitions>
            <TabControl Grid.Column="0" x:Name="tabsEditor" SelectionChanged="Document_SelectionChanged">
                <TabItem Header="Đề bài">
                    <TextBox x:Name="txtDescription" Margin="8" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Document_TextChanged" />
                </TabItem>
                <TabItem Header="Input / Output">
                    <Grid Margin="8">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="Mô tả input" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" x:Name="txtInput" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Document_TextChanged" />
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="Mô tả output" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" x:Name="txtOutput" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Document_TextChanged" />
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="Giới hạn">
                    <DockPanel Margin="8">
                        <TextBlock DockPanel.Dock="Top" Text="Bắt đầu từ cấu hình generator đang chọn; biên tập lại thành các bất đẳng thức chính thức trong đề." Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBox x:Name="txtConstraints" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Document_TextChanged" />
                    </DockPanel>
                </TabItem>
                <TabItem Header="Ví dụ">
                    <DockPanel Margin="8">
                        <Button DockPanel.Dock="Top" Content="Chèn/cập nhật từ test Sample" Click="BtnInsertSamples_Click" Padding="12,6" HorizontalAlignment="Left" Margin="0,0,0,8" Style="{StaticResource OutlineButton}" />
                        <TextBox x:Name="txtExamples" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Document_TextChanged" />
                    </DockPanel>
                </TabItem>
            </TabControl>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Xem trước đề" FontSize="15" FontWeight="SemiBold" Margin="2,0,0,8" />
                    <WebBrowser x:Name="browserPreview" />
                </DockPanel>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="lblCheckStatus" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource HintText}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Kiểm tra nhất quán" Click="BtnCheck_Click" Padding="14,7" Style="{StaticResource OutlineButton}" />
                <Button Content="Mở bản nháp…" Click="BtnLoadDraft_Click" Padding="14,7" Margin="5,0,0,0" Style="{StaticResource OutlineButton}" />
                <Button Content="Lưu bản nháp…" Click="BtnSaveDraft_Click" Padding="14,7" Margin="5,0,0,0" Style="{StaticResource OutlineButton}" />
                <Button Content="Xuất Markdown…" Click="BtnExportMarkdown_Click" Padding="14,7" Margin="5,0,0,0" Style="{StaticResource OutlineButton}" />
                <Button Content="Dùng bản đề này" Click="BtnUse_Click" Padding="16,7" Margin="5,0,0,0" />
                <Button Content="Đóng" Click="BtnClose_Click" Padding="16,7" Margin="5,0,0,0" IsCancel="True" Style="{StaticResource OutlineButton}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
