<Window x:Class="OjGen.Gui.CoverageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Độ phủ test và gợi ý" Width="720" Height="620" MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Style="{StaticResource SlideInWindow}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="lblSummary" Grid.Row="0" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBox x:Name="txtReport" Grid.Row="1" Style="{StaticResource MonoTextBox}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" />
        <Button Grid.Row="2" Content="Đóng" HorizontalAlignment="Right" Click="BtnClose_Click" Padding="18,7" Margin="0,12,0,0" IsDefault="True" IsCancel="True" />
    </Grid>
</Window>
