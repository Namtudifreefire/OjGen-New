<Window x:Class="OjGen.Gui.DifferentialResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kết quả đối chiếu lời giải" Width="900" Height="720" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Style="{StaticResource SlideInWindow}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="lblTitle" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="lblSummary" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        <TextBox Grid.Row="1" x:Name="txtDetails" Style="{StaticResource MonoTextBox}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" />
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button x:Name="btnSaveFailure" DockPanel.Dock="Left" Content="Lưu test lỗi…" Click="BtnSaveFailure_Click" Padding="16,7" Style="{StaticResource OutlineButton}" />
            <Button Content="Đóng" HorizontalAlignment="Right" Click="BtnClose_Click" Padding="18,7" IsDefault="True" IsCancel="True" />
        </DockPanel>
    </Grid>
</Window>
