<Window x:Class="OjGen.Gui.QueueManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý hàng đợi" Width="900" Height="660" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Style="{StaticResource SlideInWindow}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Hàng đợi được tự lưu và sẽ khôi phục khi mở OjGen." FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
            <ListBox x:Name="lstQueue" Grid.Column="0" SelectionChanged="LstQueue_SelectionChanged">
                <ListBox.ItemTemplate><DataTemplate>
                    <StackPanel Margin="4"><TextBlock Text="{Binding}" FontWeight="SemiBold"/><TextBlock Text="{Binding Spec.OutDir}" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis"/></StackPanel>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <Button Content="↑ Lên" Click="BtnMoveUp_Click" Padding="10,6"/>
                <Button Content="↓ Xuống" Click="BtnMoveDown_Click" Padding="10,6" Margin="0,5,0,0" Style="{StaticResource OutlineButton}"/>
                <Button Content="Xóa mục" Click="BtnRemove_Click" Padding="10,6" Margin="0,14,0,0" Style="{StaticResource OutlineButton}"/>
                <Button Content="Chỉnh kế hoạch…" Click="BtnEditPlan_Click" Padding="10,6" Margin="0,5,0,0" Style="{StaticResource OutlineButton}"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Seed" VerticalAlignment="Center"/>
            <TextBox x:Name="txtSeed" Grid.Column="1" ToolTip="Seed riêng của mục hàng đợi"/>
            <TextBlock Grid.Column="2" Text="Thư mục" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <TextBox x:Name="txtOutDir" Grid.Column="3" ToolTip="Thư mục output"/>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Áp dụng seed / thư mục" Click="BtnApply_Click" Padding="12,6" Style="{StaticResource OutlineButton}"/>
            <TextBlock x:Name="lblInfo" Style="{StaticResource HintText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
        <Button Grid.Row="4" Content="Đóng" Click="BtnClose_Click" HorizontalAlignment="Right" Padding="16,7" Margin="0,10,0,0" IsCancel="True" Style="{StaticResource OutlineButton}"/>
    </Grid>
</Window>
