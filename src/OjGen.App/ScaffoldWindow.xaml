<Window x:Class="OjGen.Gui.ScaffoldWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Khung validator / checker" Width="900" Height="720" MinWidth="760" MinHeight="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Style="{StaticResource SlideInWindow}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Tạo khung validator hoặc checker" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Mã mẫu có TODO theo khuôn đang chọn. Validator ban đầu chưa kiểm tra ràng buộc bài; checker có hợp đồng input/output/answer được ghi trong README kèm theo." Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Loại khung" VerticalAlignment="Center" />
            <ComboBox x:Name="cmbTemplate" Grid.Column="1" DisplayMemberPath="DisplayName" SelectionChanged="CmbTemplate_SelectionChanged" />
            <Button Grid.Column="2" Content="Lưu mã…" Click="BtnSave_Click" Padding="18,7" Margin="8,0,0,0" />
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
            <TextBox x:Name="txtSource" Style="{StaticResource MonoTextBox}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </Border>
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="lblHint" Style="{StaticResource HintText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Đóng" Click="BtnClose_Click" Padding="18,7" Margin="10,0,0,0" IsCancel="True" Style="{StaticResource OutlineButton}" />
        </DockPanel>
    </Grid>
</Window>
