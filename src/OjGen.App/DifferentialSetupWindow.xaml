<Window x:Class="OjGen.Gui.DifferentialSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="So sánh hai lời giải" Width="820" Height="720" MinWidth="700" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Style="{StaticResource SlideInWindow}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Kiểm thử đối chiếu (differential testing)" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="OjGen sinh test nhỏ, chạy cả hai lời giải rồi so sánh output. Nếu khác nhau, input lỗi có thể lưu ra file để sửa hoặc thêm vào bộ test." Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="135" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Lời giải chuẩn" VerticalAlignment="Center" />
                <TextBox x:Name="txtReference" Grid.Row="0" Grid.Column="1" Margin="0,0,8,6" />
                <Button Grid.Row="0" Grid.Column="2" Content="Chọn…" Click="BtnBrowseReference_Click" Style="{StaticResource OutlineButton}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Lời giải cần thử" VerticalAlignment="Center" />
                <TextBox x:Name="txtCandidate" Grid.Row="1" Grid.Column="1" Margin="0,0,8,6" />
                <Button Grid.Row="1" Grid.Column="2" Content="Chọn…" Click="BtnBrowseCandidate_Click" Style="{StaticResource OutlineButton}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Số test / seed" VerticalAlignment="Center" />
                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBox x:Name="txtCount" Width="100" ToolTip="1 .. 5000" />
                    <TextBlock Text="Seed" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <TextBox x:Name="txtSeed" Width="180" ToolTip="Để trống = chọn seed mới." />
                    <CheckBox x:Name="chkIgnoreWhitespace" Content="Bỏ qua khác biệt khoảng trắng trong output" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="Đã tự giảm các tham số kích thước phổ biến về khoảng 20; có thể chỉnh thêm ở phần cấu hình bên dưới." Style="{StaticResource HintText}" TextWrapping="Wrap" />
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="paramHost" Margin="0,0,8,0" />
            </ScrollViewer>
        </Border>
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="lblError" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Chạy đối chiếu" Click="BtnRun_Click" Padding="18,7" />
                <Button Content="Hủy" Click="BtnCancel_Click" Padding="18,7" Margin="6,0,0,0" IsCancel="True" Style="{StaticResource OutlineButton}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
