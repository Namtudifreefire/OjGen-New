<Window x:Class="OjGen.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OjGen - Trình tạo bộ test cho bài lập trình thi đấu"
        Height="800" Width="1180"
        MinHeight="660" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Style="{StaticResource SlideInWindow}"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <DockPanel>

        <!-- ================== MENU ================== -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Tệp">
                <MenuItem Header="📄 Lưu dự án" Click="MnuSaveProject_Click" InputGestureText="Ctrl+S" />
                <MenuItem Header="📄 Lưu dự án thành…" Click="MnuSaveProjectAs_Click" InputGestureText="Ctrl+Shift+S" />
                <MenuItem Header="📂 Mở dự án…" Click="MnuOpenProject_Click" InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem Header="🧩 Lưu preset ra đề…" Click="MnuSavePreset_Click" />
                <MenuItem Header="🧩 Dùng preset ra đề…" Click="MnuOpenPreset_Click" />
                <Separator />
                <MenuItem Header="📂 Mở thư mục output" Click="MnuOpenOutput_Click" />
                <Separator />
                <MenuItem x:Name="mnuStatement" Header="✍ Soạn nội dung đề…" Click="MnuStatement_Click" />
                <MenuItem x:Name="mnuPackage" Header="📦 Đóng gói bài…" Click="MnuPackage_Click" />
                <Separator />
                <MenuItem Header="Thoát" Click="MnuExit_Click" />
            </MenuItem>

            <MenuItem Header="Công cụ">
                <MenuItem x:Name="mnuQueueAdd" Header="➕ Thêm cấu hình hiện tại vào hàng đợi" Click="MnuQueueAdd_Click" />
                <MenuItem x:Name="mnuQueueManage" Header="📝 Quản lý / sắp xếp hàng đợi…" Click="MnuQueueManage_Click" IsEnabled="False" />
                <MenuItem x:Name="mnuQueueRun" Header="▶ Chạy hàng đợi (0)" Click="MnuQueueRun_Click" IsEnabled="False" />
                <Separator />
                <MenuItem x:Name="mnuRegen" Header="🔁 Tạo lại output cho thư mục test có sẵn…" Click="MnuRegen_Click" />
                <MenuItem x:Name="mnuZipDir" Header="📦 Nén ZIP thư mục test có sẵn…" Click="MnuZipDir_Click" />
                <MenuItem x:Name="mnuInventory" Header="🧾 Kiểm kê / kiểm định test có sẵn…" Click="MnuInventory_Click" />
                <MenuItem x:Name="mnuSolutionMatrix" Header="🧪 So sánh nhiều lời giải trên bộ test…" Click="MnuSolutionMatrix_Click" />
                <Separator />
                <MenuItem x:Name="mnuScaffold" Header="🧰 Tạo khung validator/checker…" Click="MnuScaffold_Click" />
                <Separator />
                <MenuItem x:Name="mnuSelfTest" Header="✅ Kiểm tra nội bộ (selftest)" Click="MnuSelfTest_Click" />
                <Separator />
                <MenuItem x:Name="mnuSettings" Header="⚙ Cài đặt…" Click="MnuSettings_Click" />
            </MenuItem>

            <MenuItem Header="Giao diện">
                <MenuItem Header="🌗 Đổi Sáng / Tối" Click="MnuToggleTheme_Click" />
                <MenuItem x:Name="mnuAutoTheme"
                          Header="⏰ Tự động đổi theme theo giờ"
                          IsCheckable="True"
                          Click="MnuAutoTheme_Click" />
                <Separator />
                <MenuItem Header="📍 Đưa cửa sổ về giữa" Click="MnuCenterWindow_Click" />
            </MenuItem>

            <MenuItem Header="Trợ giúp">
                <MenuItem Header="📖 Hướng dẫn sử dụng" Click="MnuHelp_Click" />
                <MenuItem Header="ℹ Giới thiệu" Click="MnuAbout_Click" />
            </MenuItem>
        </Menu>

        <!-- ================== STATUS BAR ================== -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Sẵn sàng" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="lblTheme" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="lblRoot" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StatusBarItem>
        </StatusBar>

        <!-- ================== TAB CONTROL ================== -->
        <TabControl x:Name="tabMain"
                    Style="{StaticResource ModernTabControl}"
                    Margin="10,10,10,5"
                    Background="Transparent">

            <!-- ============ TAB 1: TẠO BỘ TEST ============ -->
            <TabItem Header="🧪 Tạo bộ test">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ========== CỘT TRÁI: DẠNG BÀI + THAM SỐ ========== -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="16">
                                <TextBlock Text="Bước 1 · Chọn khuôn input" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="Chọn dạng input giống đề bài. Chủ đề chỉ dùng để gợi ý khuôn." Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,10" />

                                <TextBlock Text="Chủ đề gợi ý (không bắt buộc)"
                                           Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                                <TextBlock x:Name="lblAlgorithmHint"
                                           Text="Tùy chọn: tag chỉ gợi ý khuôn; hãy đối chiếu định dạng với đề."
                                           Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="3,0,3,4" />
                                <ComboBox x:Name="cmbAlgorithmTopic"
                                          DisplayMemberPath="DisplayName"
                                          IsTextSearchEnabled="True"
                                          MaxDropDownHeight="330"
                                          Margin="0,3,0,10"
                                          SelectionChanged="CmbAlgorithmTopic_SelectionChanged" />
                                <TextBlock Text="Nhóm cấu trúc" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="cmbMainCategory"
                                          IsTextSearchEnabled="True"
                                          MaxDropDownHeight="300"
                                          Margin="0,3,0,10"
                                          SelectionChanged="CmbMainCategory_SelectionChanged" />
                                <TextBlock Text="Khuôn input cụ thể" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="cmbProblem"
                                          DisplayMemberPath="Title"
                                          IsTextSearchEnabled="True"
                                          MaxDropDownHeight="430"
                                          ToolTip="{Binding SelectedItem.FormatDescription, ElementName=cmbProblem}"
                                          Margin="0,3,0,10"
                                          SelectionChanged="CmbProblem_SelectionChanged" />

                                <Button Content="✏ Đặt tên và mã bài…" Click="BtnSetupProblem_Click" Padding="12,7"
                                        HorizontalAlignment="Stretch" Style="{StaticResource OutlineButton}" />
                                <Expander Header="Tùy chọn test và kiểm thử" Margin="0,8,0,0"
                                          Foreground="{DynamicResource TextPrimaryBrush}">
                                    <UniformGrid Columns="2" Margin="0,6,0,0">
                                        <Button Content="🧩 Nhóm test…" Click="BtnTestPlan_Click" Padding="10,6" Margin="0,0,5,5"
                                                Style="{StaticResource OutlineButton}" ToolTip="Chia test thành nhóm với số lượng và cấu hình riêng." />
                                        <Button Content="📥 Thêm test tay / sample…" Click="BtnManualTests_Click" Padding="10,6" Margin="5,0,0,5"
                                                Style="{StaticResource OutlineButton}" ToolTip="Nhập test mẫu hoặc test đặc biệt; input sẽ được kiểm tra trước khi lưu." />
                                        <Button Content="⚖ So sánh lời giải…" Click="BtnDifferential_Click" Padding="10,6" Margin="0,0,5,0"
                                                Style="{StaticResource OutlineButton}" ToolTip="Chạy và đối chiếu hai lời giải trên cùng bộ input." />
                                    </UniformGrid>
                                </Expander>

                                <Border Margin="0,10,0,2" Padding="10" CornerRadius="6"
                                        Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="lblSetupSummary" Style="{StaticResource HintText}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="lblGroupPlan" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock x:Name="lblManualTests" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <Expander x:Name="expFormat" Header="Định dạng input" Margin="0,6,0,4"
                                          Foreground="{DynamicResource TextPrimaryBrush}">
                                    <TextBox x:Name="txtFormat"
                                             Style="{StaticResource MonoTextBox}"
                                             MaxHeight="190"
                                             Margin="0,6,0,0" />
                                </Expander>
                                <TextBlock Text="Bước 2 · Tham số sinh test" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,6" />
                                <StackPanel x:Name="paramHost" Margin="0,0,0,4" />
                                <TextBlock x:Name="lblValidation"
                                           Foreground="{DynamicResource ErrorBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Margin="3,8,3,0"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- ========== CỘT PHẢI ========== -->
                    <ScrollViewer Grid.Column="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                        <!-- Thiết lập chung -->
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Bước 3 · Số lượng, lời giải và nơi lưu" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Số lượng test" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtTests" Text="10" Width="130"
                                             HorizontalAlignment="Left" ToolTip="Nhập từ 1 đến 10.000 test." />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="1–10.000" VerticalAlignment="Center"
                                               Style="{StaticResource HintText}" Margin="8,0,0,0" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Seed (tùy chọn)" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                                        <TextBox x:Name="txtSeed" Width="210"
                                                 ToolTip="Để trống để chọn seed ngẫu nhiên. Cùng seed và cấu hình sẽ tái lập cùng bộ test." />
                                        <Button Content="🎲" Padding="9,6" Click="BtnRandomSeed_Click"
                                                Style="{StaticResource OutlineButton}" ToolTip="Tạo seed ngẫu nhiên" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Lời giải chuẩn (tùy chọn)" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtSolution"
                                             AllowDrop="True"
                                             PreviewDragOver="TxtSolution_PreviewDragOver"
                                             Drop="TxtSolution_Drop"
                                             ToolTip="C/C++, Python, Java, Kotlin, Pascal, C#, Rust, Go, .ojrun.json hoặc chương trình đã biên dịch. Kéo thả file vào đây. Để trống = chỉ tạo file input." />
                                    <Button Grid.Row="2" Grid.Column="2" Content="Chọn…" Click="BtnBrowseSolution_Click"
                                            Style="{StaticResource OutlineButton}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Thư mục đầu ra" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtOutDir" />
                                    <Button Grid.Row="3" Grid.Column="2" Content="Chọn…" Click="BtnBrowseOut_Click"
                                            Style="{StaticResource OutlineButton}" />

                                    <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="lblOutHint"
                                               Style="{StaticResource HintText}" />

                                    <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0">
                                        <CheckBox x:Name="chkZip" Content="Tạo file ZIP sau khi sinh test" IsChecked="True" Margin="3,3,0,3" />
                                        <Expander Header="Tùy chọn nâng cao" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,5,0,0">
                                            <UniformGrid Columns="2" Margin="8,6,0,0">
                                                <CheckBox x:Name="chkOverwrite" Content="Ghi đè test có sẵn" Margin="3"
                                                          ToolTip="Mặc định OjGen tạo thư mục mới _2, _3… khi đích đã có test." />
                                                <CheckBox x:Name="chkRebuild" Content="Biên dịch lại lời giải" Margin="3" />
                                                <CheckBox x:Name="chkZipIncomplete" Content="Cho phép ZIP khi có test lỗi" Margin="3"
                                                          ToolTip="Dùng khi cần giữ lại bộ dữ liệu chưa đủ output để kiểm tra tiếp." />
                                                <CheckBox x:Name="chkResume" Content="Lưu checkpoint để tiếp tục" Margin="3"
                                                          ToolTip="Bật từ đầu để lưu từng input/output. Lần chạy sau chỉ tiếp tục khi cùng seed, cấu hình và lời giải." />
                                            </UniformGrid>
                                        </Expander>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Xem trước -->
                        <Border Style="{StaticResource Card}" Padding="16" MinHeight="250">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                    <Button x:Name="btnPreview" DockPanel.Dock="Right" Padding="14,6"
                                            Content="👁 Kiểm tra input mẫu" Click="BtnPreview_Click"
                                            Style="{StaticResource OutlineButton}" />
                                    <StackPanel>
                                        <TextBlock Text="Bước 4 · Xem trước và kiểm tra" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock x:Name="lblPreviewInfo" Style="{StaticResource HintText}"
                                                   Text="Sinh thử test đầu tiên với seed đã nhập (không ghi file)." />
                                    </StackPanel>
                                </DockPanel>
                                <TextBox Grid.Row="1" x:Name="txtPreview" Style="{StaticResource MonoTextBox}"
                                         MinHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>

                        <!-- Hành động + kết quả -->
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Bước 5 · Sinh bộ test" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                                <DockPanel>
                                    <Button x:Name="btnCancel" DockPanel.Dock="Right" Padding="18,9" Content="⏹ Hủy"
                                            IsEnabled="False" Click="BtnCancel_Click"
                                            Style="{StaticResource OutlineButton}" />
                                    <Button x:Name="btnRun" DockPanel.Dock="Right" Padding="22,9" Content="▶ Tạo bộ test"
                                            FontSize="14" Click="BtnRun_Click" />
                                    <TextBlock x:Name="lblProgress" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Text="" />
                                </DockPanel>
                                <ProgressBar x:Name="barProgress" Height="8" Margin="3,8,3,0"
                                             Minimum="0" Maximum="100" Value="0" BorderThickness="0"
                                             Foreground="{DynamicResource AccentBrush}"
                                             Background="{DynamicResource BorderBrush}" />

                                <Border x:Name="resultPanel" Visibility="Collapsed" Margin="0,12,0,0" Padding="12"
                                        CornerRadius="8" BorderThickness="1"
                                        Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button x:Name="btnCoverage" Content="🧭 Độ phủ &amp; gợi ý" Padding="12,6"
                                                    Click="BtnCoverage_Click" Style="{StaticResource OutlineButton}" Visibility="Collapsed" />
                                            <Button x:Name="btnOpenFolder" Content="📂 Mở thư mục" Padding="12,6"
                                                    Click="BtnOpenFolder_Click" Style="{StaticResource OutlineButton}" />
                                            <Button x:Name="btnOpenZip" Content="📦 Hiện file ZIP" Padding="12,6"
                                                    Click="BtnOpenZip_Click" Style="{StaticResource OutlineButton}" />
                                            <Button x:Name="btnShowLog" Content="📋 Xem nhật ký" Padding="12,6"
                                                    Click="BtnShowLog_Click" Style="{StaticResource OutlineButton}" />
                                        </StackPanel>
                                        <TextBlock x:Name="lblResult" TextWrapping="Wrap" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============ TAB 2: NHẬT KÝ ============ -->
            <TabItem Header="📋 Nhật ký">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="🧹 Xóa nhật ký" Padding="14,6" Click="BtnClearLog_Click"
                                Style="{StaticResource OutlineButton}" />
                        <Button Content="📄 Sao chép" Padding="14,6" Click="BtnCopyLog_Click"
                                Style="{StaticResource OutlineButton}" />
                        <Button Content="💾 Lưu ra file…" Padding="14,6" Click="BtnSaveLog_Click"
                                Style="{StaticResource OutlineButton}" />
                    </StackPanel>
                    <TextBox Grid.Row="1" x:Name="txtLog" Style="{StaticResource MonoTextBox}" />
                </Grid>
            </TabItem>

            <!-- ============ TAB 3: HƯỚNG DẪN ============ -->
            <TabItem Header="📖 Hướng dẫn">
                <Border Style="{StaticResource Card}" Margin="10" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="txtHelp" TextWrapping="Wrap" FontSize="13.5" LineHeight="22" />
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
